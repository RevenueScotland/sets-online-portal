<%= ds_fields_for(company) do |c| %>
  <fieldset>
    <%= c.ds_text_field(method: :company_number, width: 10, readonly: @readonly) %>
    <% unless @readonly %>
      <%= c.builder.button "company_search", { :class => 'ds_button  ds_no-margin--top', :name => 'company_search' } do
              t('.company_search')
          end %>
    <% end %>
  </fieldset>
  <% unless company.company_name.nil? %>
    <fieldset>
      <legend><%= t('.company_details') %></legend>
      <div class="ds_inset-text">
        <p><%= company.display_selected_company.html_safe %></p>
      </div>
      <%= c.ds_hidden_field(:company_name) %>
      <%= c.ds_hidden_field(:address_line1) %>
      <%= c.ds_hidden_field(:address_line2) %>
      <%= c.ds_hidden_field(:locality) %>
      <%= c.ds_hidden_field(:county) %>
      <%= c.ds_hidden_field(:postcode) %>
      <%= c.ds_hidden_field(:country) %>
    </fieldset>
  <% end %>
<% end %>
