<% content_for :page_title, t('.title') %>
<%= ds_form_with(model: @account, url: @post_path) do |f| %>
  <%= rs_conditional_visibility(visible_value: "LBTT") do |c| %>
    <% c.with_visibility_control_radio_group(builder: f.builder, method: :taxes,
      options_list:@account.portal_services) %>
    <%= ds_warning { t('.lbtt_warning', link: ds_link(url: external_link_url('TAXPAY_SERVS'), name: t('.service_link'),target: '_blank')).html_safe } %>
  <% end %>
<% end %>
