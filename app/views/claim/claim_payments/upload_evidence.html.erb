<% content_for(:page_title, t('.title')) %>
<%= ds_form_with(model: @claim_payment, url: @post_path, file_upload: true, method: :post, button_action: (@resource_items.count == @max_file_upload_limit ? :continue : :none) ) do |f| %>
  <%= f.rs_file_upload(resource_items_hash: @resource_items_hash, resource_items: @resource_items, optional: false,
                       supported_file_types: @supported_types, max_file_size_mb: @supported_max_size_mb, multiple: true, max_uploads: @max_file_upload_limit,  hide_uploaded_files_section: true, button_label: t("ds.submit_component.continue"), button_type: :primary, hide_table_header_caption: true, show_default_label: false) %>
<% end %>
