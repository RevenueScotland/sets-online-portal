<% count = params[:sub_object_index].to_i %>
<% content_for(:page_title, t('.' + @claim_payment.translation_prefix(:party_title) + '_title', count: count, total: @claim_payment.number_of_buyers)) %>
<%= ds_paragraph{t(translation_for_index('.' + @claim_payment.translation_prefix + '_description', count))} %>
<%= ds_form_with( model: @party, url: @post_path, method: :post) do |f| %>
  <%= f.ds_text_field(method: :org_name, optional: true) if @claim_payment.reason != 'ADS'%>
  <%= f.ds_text_field(method: :firstname) %>
  <%= f.ds_text_field(method: :surname) %>
  <p class="ds_hint-text" id="email-or-phone-required-hint"><%= t("activemodel.attributes.claim/claim_payment.email_or_phone_text")  %></p>
  <%= f.ds_text_field(method: :telephone, aria_options: { "describedby": "email-or-phone-required-hint" }) %>
  <%= f.ds_text_field(method: :email_address, aria_options: { "describedby": "email-or-phone-required-hint" }) %>
<% end %>
